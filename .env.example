# Server Port
PORT=5000

# MongoDB Connection String:
# Option 1: Local MongoDB (default)
MONGO_URI=mongodb://127.0.0.1:27017/staffsync

# Option 2: Free MongoDB Atlas Cloud (recommended for deployment)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/staffsync?retryWrites=true&w=majority

# Secret for signing JWT authentication tokens
JWT_SECRET=replace_with_a_secure_random_string_here

# Environment (development or production)
NODE_ENV=development
