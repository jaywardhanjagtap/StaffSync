{
  "name": "staffsync",
  "version": "1.0.0",
  "description": "Modern human resource management solution built on the MERN stack",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "server:start": "node server/server.js",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "node server/seed.js"
  },
  "keywords": ["mern", "hr-management", "hrm", "react", "express", "mongodb", "nodejs"],
